    "typeDesc": "聚落遗址",
    "dynasty": "新石器时代中晚期（约7000—5000年前）",
    "cover": "🏺",
    "image": "",
    "summary": "中国现代考古学的发源地，“仰韶文化”的命名地",
    "intro": "仰韶村遗址位于三门峡市渑池县仰韶镇，是黄河流域新石器时代最具代表性的文化遗存之一。1921年，瑞典地质学家安特生经中国政府批准在此进行首次考古发掘，发现了以彩陶为典型特征的史前文化，由此确立了中国第一个考古学文化——仰韶文化。遗址面积约30万平方米，文化层厚达数米，出土了大量红陶、彩陶及磨制石器，是探索中华文明起源的关键遗址。",
    "archaeology": "1921年安特生首次发掘出土大量彩陶与石器；1951年、1980—1981年中国科学院考古研究所等单位多次复查与试掘，确认遗址包含仰韶文化早中晚期及龙山文化等连续地层；2000—2001年再次发掘，出土陶器、石器、骨器、蚌器等万余件，并发现房址、灰坑、墓葬等遗迹。2021年仰韶文化发现100周年之际，遗址博物馆建成开放。",
    "relics": [
      {
        "name": "小口尖底瓶",
        "desc": "仰韶文化最具代表性的汲水器，小口、深腹、尖底，腹侧有双耳，入水后自动倾倒汲水，体现史前先民的力学智慧。"
      },
      {
        "name": "彩陶花瓣纹盆",
        "desc": "泥质红陶，口沿与腹部以黑彩绘出花瓣纹与几何纹，是庙底沟类型彩陶的典型装饰母题。"
      }
    ],
    "events": [
      {
        "time": "1921年",
        "title": "中国现代考古学从这里起步",
        "desc": "安特生主持的仰韶村发掘，是中国第一次以科学方法开展的史前考古发掘，成为新石器时代考古的开端。"
      },
      {
        "time": "1923年",
        "title": "《中华远古之文化》发表",
        "desc": "安特生发表发掘报告，正式提出“仰韶文化”命名，奠定中国新石器时代研究基础。"
      },
      {
        "time": "1961年",
        "title": "首批全国重点文物保护单位",
        "desc": "仰韶村遗址被国务院公布为第一批全国重点文物保护单位。"
      }
    ],
    "poems": [
      {
        "title": "考古学界评价",
        "author": "学界共识",
        "content": "中国现代考古学从这里起步，仰韶文化是华夏文明的第一缕曙光。"
      }
    ],
    "tourism": {
      "address": "三门峡市渑池县仰韶镇仰韶村",
      "openTime": "仰韶文化博物馆：周二至周日开放，具体以景区公告为准",
      "ticket": "以景区公告为准",
      "tips": "建议与仰韶文化博物馆、渑池县城的仰韶文化产业园联游，可近距离观摩彩陶制作体验。"
    },
    "keywords": [
      "彩陶",
      "安特生",
      "考古学",
      "渑池",
      "新石器"
