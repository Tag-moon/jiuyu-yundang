# 复制为 .env 后填写真实值。不要把 .env 提交到仓库。

APP_ENV=local
PORT=3000
APP_VERSION=1.0.0-cloud-mvp
CORS_ORIGIN=*

# 本地数据兜底。部署到云上后建议改为 OBS 挂载路径或保留只读种子文件。
HERITAGE_DATA_FILE=harmony-app/entry/src/main/resources/rawfile/heritages.json
HERITAGE_IMAGE_DIR=harmony-app/entry/src/main/resources/rawfile/images

# 推荐把图片上传到 OBS，填写公网访问前缀，例如：
# OBS_IMAGE_BASE_URL=https://jiuyu-images.obs.cn-north-4.myhuaweicloud.com/heritage
OBS_IMAGE_BASE_URL=

# 华为云 RDS for MySQL。留空时使用本地 JSON 数据。
RDS_HOST=
RDS_PORT=3306
RDS_USER=
RDS_PASSWORD=
RDS_DATABASE=jiuyu_yundang

# 华为云 Redis/DCS。留空时使用进程内缓存。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# 华为云 MaaS / ModelArts Studio 兼容 OpenAI 格式的接口。
# 留空时使用内置演示模式，不会调用任何外部大模型。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 云同步令牌签名密钥。部署时必须替换为强随机字符串。
SYNC_SECRET=change-me-before-deploy
